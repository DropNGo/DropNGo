{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Find Vehicle",
  "type": "object",
  "description": "Canonical vehicle representation. Unknown values must remain null/unknown rather than being guessed.",
  "required": ["identity", "powertrain", "dimensions", "capacity", "running", "wheels", "systems", "maintenance", "sources"],
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "make": {"type":"string"}, "model": {"type":"string"}, "generation": {"type":["string","null"]},
        "facelift": {"type":["string","null"]}, "body_style": {"type":["string","null"]},
        "variant": {"type":["string","null"]}, "market": {"type":["string","null"]},
        "model_year_from": {"type":["integer","null"]}, "model_year_to": {"type":["integer","null"]}
      }, "required":["make","model"]
    },
    "powertrain": {
      "type":"object", "properties": {
        "fuel": {"type":["string","null"]}, "engine_code": {"type":["string","null"]},
        "engine_family": {"type":["string","null"]}, "displacement_cc": {"type":["number","null"]},
        "cylinders": {"type":["integer","null"]}, "forced_induction": {"type":["string","null"]},
        "power_ps": {"type":["number","null"]}, "power_kw": {"type":["number","null"]},
        "torque_nm": {"type":["number","null"]}, "transmission": {"type":["string","null"]},
        "gears": {"type":["integer","null"]}, "drivetrain": {"type":["string","null"]}
      }
    },
    "dimensions": {
      "type":"object", "properties": {
        "length_mm":{"type":["number","null"]}, "width_mm":{"type":["number","null"]}, "height_mm":{"type":["number","null"]},
        "wheelbase_mm":{"type":["number","null"]}, "curb_weight_kg":{"type":["number","null"]}, "seats":{"type":["integer","null"]}, "doors":{"type":["integer","null"]}
      }
    },
    "capacity": {
      "type":"object", "properties": {
        "fuel_tank_l":{"type":["number","null"]}, "trunk_l":{"type":["number","null"]}, "adblue_l":{"type":["number","null"]},
        "engine_oil_l":{"type":["number","null"]}, "coolant_l":{"type":["number","null"]}
      }
    },
    "running": {
      "type":"object", "properties": {
        "combined_consumption_l_100km":{"type":["number","null"]}, "electric_consumption_kwh_100km":{"type":["number","null"]},
        "range_km":{"type":["number","null"]}, "top_speed_kmh":{"type":["number","null"]}, "zero_to_100_s":{"type":["number","null"]}
      }
    },
    "wheels": {
      "type":"object", "properties": {
        "tire_sizes":{"type":"array","items":{"type":"string"}}, "rim_sizes":{"type":"array","items":{"type":"string"}},
        "brake_notes":{"type":["string","null"]}
      }
    },
    "systems": {
      "type":"object", "properties": {
        "dpf":{"type":["boolean","null"]}, "egr":{"type":["boolean","null"]}, "adblue":{"type":["boolean","null"]},
        "hybrid":{"type":["boolean","null"]}, "awd_available":{"type":["boolean","null"]}
      }
    },
    "maintenance": {
      "type":"object", "properties": {
        "interval_notes":{"type":["string","null"]}, "known_weak_points":{"type":"array","items":{"type":"string"}},
        "recall_notes":{"type":"array","items":{"type":"string"}}
      }
    },
    "sources": {
      "type":"array", "items":{"type":"object","properties":{
        "url":{"type":"string"}, "source_type":{"type":"string"}, "retrieved_at":{"type":"string"},
        "confidence":{"type":"number","minimum":0,"maximum":1}, "fields":{"type":"array","items":{"type":"string"}}
      },"required":["url","source_type","confidence"]}
    }
  }
}
