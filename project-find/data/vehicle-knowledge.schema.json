    "maintenance":{"type":"object","properties":{"interval_notes":{"type":["string","null"]},"known_issues":{"type":"array","items":{"type":"string"}},"recall_notes":{"type":"array","items":{"type":"string"}}}},
    "sources":{"type":"array","items":{"type":"object","required":["url","type"],"properties":{"url":{"type":"string"},"type":{"type":"string"},"retrieved_at":{"type":"string"}}}},
    "confidence":{"type":"object","additionalProperties":{"type":"number","minimum":0,"maximum":1}}
