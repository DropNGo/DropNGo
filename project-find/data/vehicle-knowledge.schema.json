  "properties":{
    "identity":{"type":"object","properties":{"make":{"type":["string","null"]},"model":{"type":["string","null"]},"generation":{"type":["string","null"]},"facelift":{"type":["string","null"]},"body":{"type":["string","null"]},"variant":{"type":["string","null"]},"production_years":{"type":"object","properties":{"from":{"type":["integer","null"]},"to":{"type":["integer","null"]}}}},
    "engine":{"type":"object","properties":{"family":{"type":["string","null"]},"code":{"type":["string","null"]},"displacement_cc":{"type":["integer","null"]},"cylinders":{"type":["integer","null"]},"induction":{"type":["string","null"]},"fuel":{"type":["string","null"]},"power_ps":{"type":["number","null"]},"power_kw":{"type":["number","null"]},"torque_nm":{"type":["number","null"]}}},
    "drivetrain":{"type":"object","properties":{"transmission":{"type":["string","null"]},"gears":{"type":["integer","null"]},"drive":{"type":["string","null"]}}},
    "dimensions":{"type":"object","properties":{"length_mm":{"type":["number","null"]},"width_mm":{"type":["number","null"]},"height_mm":{"type":["number","null"]},"wheelbase_mm":{"type":["number","null"]},"curb_weight_kg":{"type":["number","null"]},"seats":{"type":["integer","null"]},"doors":{"type":["integer","null"]},"boot_l":{"type":["number","null"]},"fuel_tank_l":{"type":["number","null"]}}},
